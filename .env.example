# Option A: Vercel KV (auto-injected when you connect KV from Vercel Marketplace)
KV_REST_API_URL=https://your-kv.kv.vercel-storage.com
KV_REST_API_TOKEN=your-kv-token

# Option B: Direct Upstash Redis (auto-injected when you connect Upstash Redis)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Required: Generate a random 32+ character string
# Run: openssl rand -hex 32
APP_SECRET=your-random-32-character-secret-here

# Required: One-time setup token (used only during initial setup wizard)
SETUP_TOKEN=your-setup-token
